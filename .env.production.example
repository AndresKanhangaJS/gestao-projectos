# Configuracao de PRODUCAO (docker-compose.prod.yml).
# Copiar para .env.production (na raiz do repositorio) e preencher os valores marcados com <...>.
# .env.production NUNCA vai para o git (esta no .gitignore). Guia: docs/DEPLOY.md
#
# Usar SEMPRE: docker compose --env-file .env.production -f docker-compose.prod.yml ...
# O ficheiro inteiro vai para app/queue/scheduler; mysql, redis e backup recebem so as variaveis
# de que precisam (DB_*, REDIS_PASSWORD, BACKUP_*, TZ), por interpolacao no docker-compose.prod.yml.
#
# Regras deste ficheiro:
#  - uma variavel por linha, sem "export";
#  - nas passwords usar so letras, numeros e - _ . @ % + = (sem aspas, $, espacos nem barras invertidas;
#    o Compose interpreta "$" como variavel). Ex.: openssl rand -base64 32 | tr -d "/+=" | cut -c1-32

APP_NAME="Gestão de Projectos"
APP_ENV=production
APP_DEBUG=false
# Gerar com: docker compose --env-file .env.production -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://gestao.level-soft.local
FRONTEND_URL=https://gestao.level-soft.local

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
TZ=Africa/Luanda

# Arranque do contentor app: corre "migrate --force" antes do php-fpm.
RUN_MIGRATIONS=true
# Nunca true em producao: criaria utilizadores demo com password "password".
SEED_DEMO_DATA=false

# Logs para stderr: consultar com "docker compose --env-file .env.production -f docker-compose.prod.yml logs app" (rotacao feita pelo Docker).
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base de dados (contentor mysql, sem portas expostas). O MySQL e inicializado com estes valores
# no PRIMEIRO arranque; mudar depois exige alterar tambem as contas dentro do MySQL.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gestao_projectos
DB_USERNAME=gestao
DB_PASSWORD=<password-forte-app>
DB_ROOT_PASSWORD=<password-forte-root>

# Redis (contentor redis, sem portas expostas, com password obrigatoria).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<password-forte-redis>
CACHE_STORE=redis
CACHE_PREFIX=gestao_
QUEUE_CONNECTION=redis

# Sessoes na BD (tabela sessions): permite ao UserAccountService terminar sessoes
# ao desactivar um utilizador ou repor/mudar a palavra-passe.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Vazio = cookie so para o host exacto (recomendado). So preencher se precisar de partilhar
# a sessao com subdominios (ex. .level-soft.local).
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Registo publico (POST /api/register, cria contas "member"). Fechado por omissao: as contas sao
# criadas pelo administrador (Administracao > Utilizadores). So ligar (true) se for mesmo necessario.
AUTH_REGISTRATION_ENABLED=false

# Dominio(s) de onde a SPA faz pedidos (host[:porta], sem https://). TEM de coincidir com o
# endereco que os utilizadores escrevem no browser, senao o login devolve 419.
SANCTUM_STATEFUL_DOMAINS=gestao.level-soft.local
# SPA e API no mesmo dominio: CORS so e relevante se outra origem aceder a API.
CORS_ALLOWED_ORIGINS=https://gestao.level-soft.local

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email (SMTP real da Level-Soft).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.level-soft.local>
MAIL_PORT=587
MAIL_USERNAME=<utilizador-smtp>
MAIL_PASSWORD=<password-smtp>
MAIL_FROM_ADDRESS="nao-responder@level-soft.local"
MAIL_FROM_NAME="Gestão de Projectos"

# Backups (servico "backup"): diario a BACKUP_HOUR:BACKUP_MINUTE (fuso TZ), guardados em ./backups.
BACKUP_HOUR=02
BACKUP_MINUTE=00
BACKUP_RETENTION_DAYS=14

# Opcional (Compose): portas publicadas, versao das imagens e pasta dos backups.
# HTTP_PORT=80
# HTTPS_PORT=443
# APP_VERSION=latest
# BACKUP_PATH=./backups
