# Normaliza finais de linha no repositório (LF), independentemente do core.autocrlf local.
* text=auto eol=lf

# Scripts e configs executados dentro de contentores Linux têm de ser LF.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.yml text eol=lf

# Scripts Windows mantêm CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
